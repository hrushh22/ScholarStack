# ScholarStack environment variables
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every service below has a free tier - no credit card is required.

# --- LLM (Groq, free tier, OpenAI-compatible) -----------------------------
# Sign in at https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Smaller/faster model used as an automatic fallback when the main one is rate limited
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Reasoning models: keep effort low to save free-tier tokens
LLM_REASONING_EFFORT=low
# Evaluation judge: a different model family than the generator (reduces self-preference bias)
JUDGE_MODEL=qwen/qwen3.8-27b

# --- Supabase (free tier: Postgres + pgvector + Edge Functions) ------------
# 1. https://supabase.com/dashboard -> New project (save the database password)
# 2. Project URL: Project Settings -> Data API -> Project URL
SUPABASE_URL=
# 3. Connection string: "Connect" button (top bar) -> Session pooler -> URI
#    (replace [YOUR-PASSWORD] with your database password)
SUPABASE_DB_URL=
# 4. Personal access token (used only to deploy the Edge Function and read API keys):
#    https://supabase.com/dashboard/account/tokens -> Generate new token
SUPABASE_ACCESS_TOKEN=
# Filled in automatically by `python pipeline/12_deploy_supabase.py` (public by design, safe in the browser)
SUPABASE_PUBLISHABLE_KEY=

# --- Optional: cloud copy of the raw data via fsspec ----------------------
# Leave blank to keep raw data local. Example: s3://scholarstack-raw (Supabase Storage S3 endpoint)
RAW_STORAGE_URL=
RAW_STORAGE_ENDPOINT=
RAW_STORAGE_KEY=
RAW_STORAGE_SECRET=
